# 复制本文件为 .env 并填入你自己的密钥（切勿把真实密钥提交到版本库）

# 高德地图 API（https://lbs.amap.com/）
AMAP_KEY=你的高德Key
AMAP_SECURITY_CODE=你的高德安全密钥

# DeepSeek API（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 美团开放平台（可选，评价聚合用；不配置时自动回退到内置数据）
MEITUAN_ACCESS_TOKEN=你的美团AccessToken

# 会话签名密钥（必填！生成方式：python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=你的随机密钥

# 服务端口
PORT=8000

# 前端地址（CORS 白名单，多个用英文逗号分隔）
FRONTEND_URL=http://localhost:3000
